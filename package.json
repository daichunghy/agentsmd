{
  "name": "agentsmd",
  "version": "0.1.0-alpha.1",
  "description": "One source of truth for AI agent instructions — linted, wired, scored.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agentsmd": "dist/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:action": "esbuild src/action/index.ts --bundle --platform=node --target=node20 --outfile=action-dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build && npm run build:action && npm run test"
  },
  "keywords": [
    "agents-md",
    "agentsmd",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "github-copilot",
    "ai-agents",
    "cli",
    "linting",
    "context-engineering"
  ],
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@types/node": "^26.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
