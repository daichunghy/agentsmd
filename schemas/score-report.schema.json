{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agentsmd score report",
  "type": "object",
  "required": ["schemaVersion", "score", "breakdown", "notes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "breakdown": {
      "type": "object",
      "required": ["coverage", "freshness", "wiring", "size"],
      "additionalProperties": false,
      "properties": {
        "coverage": { "type": "integer", "minimum": 0, "maximum": 30 },
        "freshness": { "type": "integer", "minimum": 0, "maximum": 30 },
        "wiring": { "type": "integer", "minimum": 0, "maximum": 25 },
        "size": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
